{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run locales && vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "build-only": "bun run locales && vite build",
    "type-check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "check": "bun run locales --check && bun run format && bun run type-check && bun run lint",
    "locales": "node scripts/sync-locales.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.46.0",
    "axios": "^1.20.0",
    "bits-ui": "^1.8.0",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.2.1",
    "svelte-spa-router": "^5.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.83.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.83.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
